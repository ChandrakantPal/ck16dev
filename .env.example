# Every signal provider is optional. An unset one is skipped, and /now renders
# the rest — no provider can break the page.

# Spotify — record player, and the "on repeat" card.
# Get the refresh token with: npx tsx scripts/spotify-auth.ts
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=



# Goodreads — the numeric ID from your profile URL. Shelf defaults to
# currently-reading.
GOODREADS_USER_ID=
GOODREADS_SHELF=

# GitHub — works with no token at all. A token only raises the rate limit.
GITHUB_USERNAME=ChandrakantPal
GITHUB_TOKEN=
